# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Voice (ElevenLabs): key + a Turkish voice id from the Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Optional: cheaper Google voice, AI-drawn image scenes
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
# Render on GitHub (npm run bulut): fine-grained token for this repository only,
# permissions Contents + Actions (+ Workflows) read/write
GITHUB_TOKEN=
